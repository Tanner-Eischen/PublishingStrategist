{
  "notifications": {
    "enabled": true,
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 587,
      "use_tls": true,
      "from": "alerts@kdpstrategist.com",
      "to": ["admin@kdpstrategist.com", "ops@kdpstrategist.com"],
      "username": "${SMTP_USERNAME}",
      "password": "${SMTP_PASSWORD}"
    },
    "webhook_url": "${WEBHOOK_URL}",
    "slack": {
      "enabled": false,
      "webhook_url": "${SLACK_WEBHOOK_URL}",
      "channel": "#alerts"
    }
  },
  "escalation": {
    "enabled": true,
    "levels": [
      {
        "severity": "medium",
        "delay_minutes": 15,
        "recipients": ["ops@kdpstrategist.com"]
      },
      {
        "severity": "high",
        "delay_minutes": 5,
        "recipients": ["admin@kdpstrategist.com", "ops@kdpstrategist.com"]
      },
      {
        "severity": "critical",
        "delay_minutes": 0,
        "recipients": ["admin@kdpstrategist.com", "ops@kdpstrategist.com", "cto@kdpstrategist.com"]
      }
    ]
  },
  "auto_resolve_timeout": 3600,
  "rate_limits": {
    "google_trends": 100,
    "keepa_api": 50,
    "amazon_api": 200
  },
  "thresholds": {
    "api_failure_rate": 5,
    "response_time_ms": 5000,
    "cache_hit_rate_percent": 50,
    "memory_usage_percent": 90,
    "disk_usage_percent": 85,
    "error_rate_percent": 10
  },
  "actions": {
    "clear_cache": {
      "enabled": true,
      "timeout": 60,
      "retry_count": 2,
      "cooldown": 300
    },
    "restart_service": {
      "enabled": true,
      "timeout": 120,
      "retry_count": 1,
      "cooldown": 600
    },
    "activate_fallback": {
      "enabled": true,
      "timeout": 30,
      "retry_count": 1,
      "cooldown": 180
    },
    "adjust_rate_limits": {
      "enabled": true,
      "timeout": 10,
      "retry_count": 1,
      "cooldown": 300
    }
  }
}