# KDP Strategist Environment Configuration
# Copy this file to .env and add your actual API keys
# NEVER commit .env file to version control

# ===== REQUIRED API KEYS =====

# Keepa API Key (Required)
# Get your free API key from https://keepa.com/#!api
KEEPA_API_KEY=your_keepa_api_key_here

# Ubersuggest API Key (Optional - for enhanced search volume data)
# Get your API key from https://app.ubersuggest.io/api
UBERSUGGEST_API_KEY=your_ubersuggest_api_key_here

# ===== BASIC SETTINGS =====

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Cache Configuration
CACHE_TYPE=file                    # Options: file, redis, memory
CACHE_TTL=3600                     # Cache duration in seconds (1 hour)



# ===== ADVANCED SETTINGS (Optional) =====

# API Timeouts and Retries
API_REQUEST_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_DELAY=1.0

# Business Logic
MIN_PROFITABILITY_SCORE=50.0
MAX_COMPETITION_SCORE=70.0
MAX_NICHES_PER_QUERY=10

# Server Configuration
MCP_HOST=localhost
MCP_PORT=8000
MCP_ENABLE_CORS=true

# ===== REDIS CONFIGURATION (Optional) =====
# Uncomment these if using Redis cache (recommended for production)

# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# ===== LOGGING (Optional) =====

# LOG_FILE=logs/kdp_strategist.log
# LOG_MAX_FILE_SIZE=10485760
# LOG_BACKUP_COUNT=5